{
  "name": "opencode-permission-guard",
  "version": "0.1.0",
  "description": "Fail-closed shell permission guard for OpenCode with an optional local reviewer model",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pskraemer11/permission-guard.git"
  },
  "bugs": {
    "url": "https://github.com/pskraemer11/permission-guard/issues"
  },
  "homepage": "https://github.com/pskraemer11/permission-guard#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "permissions",
    "guard",
    "shell",
    "llama.cpp",
    "local-llm"
  ],
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/guard.js",
    "src/index.js",
    "src/reviewer.js",
    "src/audit.js",
    "src/diagnostics.js",
    "src/shadow.js",
    "src/git-shadow-report.mjs",
    "src/verify-audit.mjs",
    "src/mcp-report.mjs",
    "src/skill-verdicts.mjs",
    "test/test.mjs",
    "test/test-wiring.mjs",
    "test/bench-mcp.mjs",
    "test/bench-model.mjs",
    "test/mcp-cases.jsonl",
    "test/mcp-model-cases.jsonl",
    "src/stats.mjs",
    "src/replay.mjs",
    "src/analyze.mjs",
    "test/smoke-reviewer.mjs",
    "scripts/bench-reviewer.ps1",
    "scripts/bench-quality.ps1",
    "scripts/watchdog-reviewer.ps1",
    "scripts/start-reviewer.ps1",
    "scripts/deploy.ps1",
    "scripts/deploy.sh",
    "shell-reviewer.config.example.json",
    "README.md",
    "LICENSE",
    "test/test-index.mjs",
    "test/bench-shell.mjs",
    "test/shell-model-cases.jsonl"
  ],
  "scripts": {
    "test": "node test/test.mjs",
    "test:wiring": "node test/test-wiring.mjs",
    "bench": "node test/bench-mcp.mjs",
    "bench:model": "node test/bench-model.mjs --repeat 3",
    "verdicts": "node src/skill-verdicts.mjs",
    "verify-audit": "node src/verify-audit.mjs",
    "report": "node src/mcp-report.mjs",
    "shadow-report": "node src/git-shadow-report.mjs",
    "smoke": "node test/smoke-reviewer.mjs",
    "test:index": "node test/test-index.mjs",
    "bench:shell": "node test/bench-shell.mjs --repeat 3"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "overrides": {
    "minimatch": "11.0.9",
    "glob": "14.0.6"
  }
}
