{
  "name": "opencode-permission-guard",
  "version": "0.1.0",
  "description": "Fail-closed shell permission guard for OpenCode with an optional local reviewer model",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "permissions",
    "guard",
    "shell",
    "llama.cpp",
    "local-llm"
  ],
  "files": [
    "guard.js",
    "index.js",
    "reviewer.js",
    "audit.js",
    "verify-audit.mjs",
    "mcp-report.mjs",
    "bench-model.mjs",
    "mcp-model-cases.jsonl",
    "test.mjs",
    "skill-verdicts.mjs",
    "shell-reviewer.config.example.json",
    "start-reviewer.ps1",
    "deploy.ps1",
    "deploy.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.mjs",
    "verdicts": "node skill-verdicts.mjs",
    "verify-audit": "node verify-audit.mjs",
    "report": "node mcp-report.mjs",
    "bench:model": "node bench-model.mjs --repeat 3",
    "smoke": "node smoke-reviewer.mjs"
  }
}
